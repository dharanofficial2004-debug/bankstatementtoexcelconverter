# OpenAI Configuration (kept for future use)
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4.1-mini

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Affitor (server-only; never use NEXT_PUBLIC_ for these secrets)
AFFITOR_API_KEY=
RAZORPAY_AFFITOR_WEBHOOK_SECRET=

# Google Indexing API — Service Account (from Google Cloud Console JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Worker authentication scheme (choose ONE):
# Option A — Shared secret (current default, works with outbox drain + Cloud Tasks)
WORKER_SHARED_SECRET=your-random-secret-here

# Option B — OIDC only (Cloud Tasks native, cannot use with outbox drain direct dispatch)
# CLOUD_TASKS_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
# If using OIDC only, do NOT set WORKER_SHARED_SECRET and do NOT use direct fetch fallback.

# Vercel Cron secret (auto-added by Vercel, used to authenticate /api/internal/outbox cron calls)
CRON_SECRET=auto-provided-by-vercel

# Configurable retention windows
EXTRACTED_TEXT_TTL_HOURS=2
RESULT_RETENTION_DAYS=90

# GeoIP — Country/city detection uses Vercel built-in headers (x-vercel-ip-country, x-vercel-ip-city)
# MaxMind is NOT required on Vercel. Credentials below are for future self-hosted use only.
# MAXMIND_ACCOUNT_ID=your_account_id
# MAXMIND_LICENSE_KEY=your_license_key
